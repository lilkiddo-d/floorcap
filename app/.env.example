# Chain to use: 4663 (Robinhood Chain mainnet) or 31337 (local anvil fork, see DEPLOY.md)
NEXT_PUBLIC_CHAIN_ID=4663
# RPC URL used by the browser. Default: public Robinhood RPC (rate-limited; use a provider for production)
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# WalletConnect Cloud project id (optional; without it only injected wallets are offered)
NEXT_PUBLIC_WC_PROJECT_ID=
# Project token ($FCAP) address. EMPTY = all token features hidden. See TOKEN_INTEGRATION.md
NEXT_PUBLIC_PROJECT_TOKEN=
# Optional geoblock: comma-separated ISO-3166 alpha-2 country codes to block (uses Vercel's IP country header)
NEXT_PUBLIC_GEOBLOCK=
